<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
         />

    <EditText
        android:id="@+id/nume_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introduce_numele"
        android:inputType="text"
        />

    <CheckBox
        android:id="@+id/check_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/esti_student"
        />

    <Button
        android:id="@+id/buton_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apasa"
        />

    <Button
        android:id="@+id/buton_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/introdu_avion"
        />

    <Button
        android:id="@+id/buton_lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Afiseaza lista"/>

</LinearLayout>