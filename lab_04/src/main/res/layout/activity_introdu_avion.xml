<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".IntroduAvion"
    android:orientation="vertical">

    <EditText
        android:id="@+id/model_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input model of airplane"
        android:inputType="text"/>
    <EditText
        android:id="@+id/id_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input the ID of the airplane"
        android:inputType="text"/>
    <EditText
        android:id="@+id/manufacturer_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input the airplane manufacturer"
        android:inputType="text"/>
    <EditText
        android:id="@+id/flightHours_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input the airplanes flight hours"
        android:inputType="number"/>
    <EditText
        android:id="@+id/value_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input the airplanes value"
        android:inputType="number"/>
    <CheckBox
        android:id="@+id/disponibil_avion_CB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Avion disponibil" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tip avion:" />

    <RadioGroup
        android:id="@+id/tip_avion_RG"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/pasageri_RB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pasageri" />

        <RadioButton
            android:id="@+id/cargo_RB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargo" />

    </RadioGroup>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Categoria avionului:" />

    <Spinner
        android:id="@+id/categorie_avion_SP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/categorii_avion" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Starea tehnica a avionului:" />

    <RatingBar
        android:id="@+id/stare_avion_RB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1"
        android:rating="3" />
    <Switch
        android:id="@+id/in_serviciu_SW"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Avionul este in serviciu"
        android:checked="true" />
    <Button
        android:id="@+id/buton_avion2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save"/>

</LinearLayout>