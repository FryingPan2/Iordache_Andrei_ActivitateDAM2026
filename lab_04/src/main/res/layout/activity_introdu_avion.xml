<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".IntroduAvion"
    android:orientation="vertical">

    <EditText
        android:id="@+id/model_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input model of airplane"
        android:inputType="text"/>
    <EditText
        android:id="@+id/id_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input the ID of the airplane"
        android:inputType="text"/>
    <EditText
        android:id="@+id/manufacturer_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input the airplane manufacturer"
        android:inputType="text"/>
    <EditText
        android:id="@+id/flightHours_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input the airplanes flight hours"
        android:inputType="number"/>
    <EditText
        android:id="@+id/value_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input the airplanes value"
        android:inputType="number"/>
    <Button
        android:id="@+id/buton_avion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Input Data"/>

</LinearLayout>